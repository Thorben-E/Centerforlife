		<div class="ml-embedded mx-auto mt-6 max-w-lg text-left" data-form="OXadBd"></div>
	</div>
	<div class="flex flex-col items-center justify-center gap-3 border-t border-gray-200 px-6 py-6 text-sm text-[#0f6dbf] sm:flex-row sm:gap-6">
		<p>Center for Life / Hannah Mutsaerts</p>
		<a href="mailto:info@centerforlife.nl">info@centerforlife.nl</a>
		<div class="flex gap-3">
