---
import Layout from '../layouts/Layout.astro';
import Footer from '../layouts/Footer.astro';

const stripeLinks = {
  masterclass1: 'https://buy.stripe.com/aFa00j7Au1oI5ySeMzeZ208',
  masterclass2: 'https://buy.stripe.com/aFa9AT4oi6J2d1k5bZeZ20b',
  masterclass3: 'https://buy.stripe.com/cNi3cv4oi1oI8L4gUHeZ209',
  allThree: 'https://buy.stripe.com/3cI28r7Au0kE8L40VJeZ20c'
};

const masterclasses = [
  {
    number: 1,
    date: '24 januari',
    dayLabel: 'Zondag 24 januari',
    cardTitle: 'Masterclass 1 Basis – Voeten, enkels en knieën – 24 januari',
    shortTheme: 'Basis – Voeten, enkels en knieën',
    drieluikTheme: 'de Basis – Voeten, enkels en knieën',
    image: '/masterclasses/masterclass-1-basis.jpg',
    alt: 'Masterclass 1 Basis – Voeten, enkels en knieën – 24 januari',
    href: stripeLinks.masterclass1,
  },
  {
    number: 2,
    date: '21 maart',
    dayLabel: 'Zondag 21 maart',
    cardTitle: 'Masterclass 2: Fundament – bovenbenen, bekken, onderrug – 21 maart',
    shortTheme: 'Fundament – bovenbenen, bekken, onderrug',
    drieluikTheme: 'het Fundament – Bovenbenen, bekken en onderrug',
    image: '/masterclasses/masterclass-2-fundament.jpg',
    alt: 'Masterclass 2: Fundament – bovenbenen, bekken, onderrug – 21 maart',
    href: stripeLinks.masterclass2,
  },
  {
    number: 3,
    date: '9 mei',
    dayLabel: 'Zondag 9 mei',
    cardTitle: 'Masterclass 3: De As – schouders, nek en armen – 9 mei',
    shortTheme: 'De As – schouders, nek en armen',
    drieluikTheme: 'de As – Schouders, wervelkolom en bovenrug',
    image: '/masterclasses/masterclass-3-as.jpg',
    alt: 'Masterclass 3: De As – schouders, nek en armen – 9 mei',
    href: stripeLinks.masterclass3,
  },
];

const filledButton = 'inline-block rounded-lg bg-[#0f6dbf] px-5 py-2.5 text-sm font-medium text-white transition hover:bg-[#0b5aa0]';
const outlineButton = 'inline-block rounded-lg border-2 border-[#0f6dbf] bg-white px-5 py-2.5 text-sm font-medium text-[#0f6dbf] transition hover:bg-blue-50';
---

<Layout title="Masterclasses WORK – IN | Centerforlife">
  <main>

    <!-- Hero Section (Wit, zelfde ritme & stijl als Work-In / Shiatsu) -->
    <section class="mx-auto max-w-6xl px-6 py-12 space-y-10">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">

        <div class="lg:col-span-7 space-y-5">
          <div>
            <h1 class="text-4xl text-[#0f6dbf] leading-tight">
              Masterclasses
              <span class="block mt-1" style="font-family: 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;">WORK – IN</span>
            </h1>
            <p class="mt-2 text-xl italic text-gray-700">
              Geen work-out, maar een work-in
            </p>
          </div>

          <div class="space-y-3 text-gray-800 leading-relaxed">
            <p>
              Stap 3,5 uur uit je dagelijkse routine. Geen haast, geen afleiding, kwaliteit voor jou.
            </p>
            <p class="font-medium text-gray-900">
              Ervaar praktisch hoe jij:
            </p>
            <ul class="list-disc space-y-1.5 pl-5">
              <li>je zenuwstelsel kalmeert,</li>
              <li>je optimaal je lichaam beweegt,</li>
              <li>in je lijf zakt (in plaats van in je hoofd),</li>
              <li>jezelf mentaal een gezondheids boost geeft, en</li>
              <li>diep ontspant</li>
            </ul>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a href="#inschrijven" class={filledButton}>
              Meld me aan voor de middag
            </a>
            <a href="#inhoud" class={outlineButton}>
              Lees de inhoud
            </a>
          </div>
        </div>

        <!-- Data, Tijden & Prijzen -->
        <div class="lg:col-span-5">
          <div class="rounded-lg border border-blue-200 bg-blue-50 p-6 space-y-5">
            <h2 class="text-lg font-semibold text-[#0f6dbf] border-b border-blue-200 pb-3">
              Data, Tijden &amp; Prijzen
            </h2>

            <div class="space-y-2 text-sm text-gray-800">
              <p><strong class="text-gray-900">24 januari:</strong> Masterclass 1 (Basis – Voeten, enkels en knieën)</p>
              <p><strong class="text-gray-900">21 maart:</strong> Masterclass 2 (Fundament – Bovenbenen, bekken, onderrug)</p>
              <p><strong class="text-gray-900">9 mei:</strong> Masterclass 3 (De As – Schouders, nek en armen)</p>
            </div>

            <div class="pt-3 border-t border-blue-200/80 space-y-2 text-sm text-gray-800">
              <div class="space-y-1.5">
                <p class="font-semibold text-gray-900">Tijden:</p>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-gray-500 line-through">Ochtend: 9:30u – 13:00u</span>
                  <span class="rounded border border-gray-300 bg-white px-2 py-0.5 text-xs font-medium text-gray-600">
                    Uitverkocht
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-semibold text-gray-900">Middag: 14:00u – 17:30u</span>
                  <span class="rounded bg-[#0f6dbf] px-2 py-0.5 text-xs font-semibold text-white">
                    16 nieuwe plekken · op = op
                  </span>
                </div>
              </div>
              <p class="pt-1"><strong class="text-gray-900">Locatie:</strong> Home of Zen, Velperweg 95, Arnhem</p>
              <p class="text-xs text-[#0f6dbf] font-medium">Let op: niet in de studio in Velp!</p>
            </div>

            <div class="pt-3 border-t border-blue-200/80 space-y-1.5 text-sm text-gray-800">
              <p><strong class="text-gray-900">1 masterclass:</strong> €60</p>
              <p><strong class="text-gray-900">Alle 3 masterclasses:</strong> €150 <span class="text-gray-600">(bespaar €30)</span></p>
            </div>

            <a href="#inschrijven" class="block w-full rounded-lg bg-[#0f6dbf] hover:bg-[#0b5aa0] py-2.5 text-center text-sm font-medium text-white transition">
              Direct inschrijven (middag)
            </a>
          </div>
        </div>

      </div>

      <!-- Aankondiging in de huisstijl (border-l-4 border-[#0f6dbf], zoals Work-In) -->
      <div class="rounded-r-lg border border-blue-200 border-l-4 border-l-[#0f6dbf] bg-blue-50 p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <p class="text-sm sm:text-base leading-relaxed text-gray-800">
          <strong class="text-[#0f6dbf]">Wegens groot succes zijn de masterclasses in de ochtend uitverkocht.</strong> Gezien de grote vraag wordt de masterclass nu ook in de middag (<strong class="text-gray-900">14:00u – 17:30u</strong>) gegeven, waardoor er <strong class="text-gray-900">16 nieuwe plekken</strong> per sessie zijn. Meld je aan, want <strong class="text-gray-900">op = op</strong>!
        </p>
        <a href="#inschrijven" class={`${filledButton} shrink-0 text-center`}>
          Plek reserveren
        </a>
      </div>
    </section>

    <!-- 3 Masterclasses Platen & Titels (bg-blue-50 band) -->
    <section class="bg-blue-50">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {masterclasses.map((mc) => (
            <article class="flex flex-col justify-between overflow-hidden rounded-lg border border-blue-100 bg-white">
              <div>
                <div class="aspect-[16/10] overflow-hidden bg-gray-100">
                  <img 
                    src={mc.image} 
                    alt={mc.alt} 
                    class="h-full w-full object-cover" 
                    loading="lazy" 
                  />
                </div>
                <div class="p-6 space-y-2.5">
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="rounded border border-gray-200 bg-gray-50 px-2 py-0.5 text-gray-500 line-through">Ochtend uitverkocht</span>
                    <span class="rounded bg-blue-50 px-2 py-0.5 font-semibold text-[#0f6dbf]">Middag 14:00u – 17:30u · 16 plekken</span>
                  </div>
                  <h3 class="text-base font-semibold text-gray-900 leading-snug">
                    {mc.cardTitle}
                  </h3>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a 
                  href={mc.href} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="flex w-full items-center justify-center rounded-lg border-2 border-[#0f6dbf] bg-white px-4 py-2 text-xs font-semibold text-[#0f6dbf] transition hover:bg-[#0f6dbf] hover:text-white"
                >
                  Inschrijven Masterclass {mc.number} – Middag (€60)
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Inhoud Section (#inhoud, wit) -->
    <section id="inhoud" class="scroll-mt-20 mx-auto max-w-6xl px-6 py-12">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">

        <!-- Wat houden de masterclasses in? -->
        <article class="rounded-lg border border-gray-200 bg-white p-7 space-y-4">
          <h2 class="text-2xl text-[#0f6dbf]">Wat houden de masterclasses in?</h2>
          <p class="text-gray-700 leading-relaxed text-sm">
            Dit is een actieve WORK-IN. We gaan doeltreffend bewegen, veiligheid ervaren en diep meditatief ontspannen. De uitleg krijg je tijdens het bewegen, zodat de kennis landt in je fascie, spieren en zenuwstelsel.
          </p>
          <div class="pt-1 space-y-2 text-sm text-gray-700">
            <p class="font-medium text-gray-900">We slaan een brug tussen:</p>
            <ul class="list-disc space-y-2 pl-5 leading-relaxed">
              <li>
                <strong class="text-gray-900">Westers bewegen door Fasciewerk en Biomechanica:</strong> ervaar hoe het fysieke lichaam anatomisch functioneert en hoe je compensaties in jouw manier van bewegen herprogrammeert.
              </li>
              <li>
                <strong class="text-gray-900">Oosters bewegen via Yoga en Qi Gong:</strong> laat je levensenergie stromen en toenemen door Yoga, Traditionele Chinese geneeskunde en Taoïsme.
              </li>
            </ul>
          </div>
        </article>

        <!-- Voor wie? -->
        <article class="rounded-lg border border-gray-200 bg-white p-7 space-y-4">
          <h2 class="text-2xl text-[#0f6dbf]">Voor wie?</h2>
          <ul class="list-disc space-y-2 text-sm text-gray-700 leading-relaxed pl-5">
            <li>Je komt al jaren bij mij op de mat en zoekt meer diepgang of verfijning.</li>
            <li>Je merkt dat je vastzit in je hoofd of in een gespannen lijf.</li>
            <li>Je wil meer ontdekken over de wonderlijke wereld van het fascie.</li>
            <li>Ervaren en meer beginnende deelnemers zijn welkom.</li>
          </ul>
          <p class="text-sm text-gray-700 pt-3 border-t border-gray-200">
            Ben je bij de vorige masterclasses geweest? Het uitgangspunt is nu hetzelfde maar we gebruiken veel andere oefeningen.
          </p>
        </article>

        <!-- Wat kun je verwachten? -->
        <article class="rounded-lg border border-gray-200 bg-white p-7 space-y-4">
          <h2 class="text-2xl text-[#0f6dbf]">Wat kun je verwachten?</h2>
          <ul class="list-disc space-y-2.5 text-sm text-gray-700 leading-relaxed pl-5">
            <li>
              <strong class="text-gray-900">Al doende leren:</strong> geen droge powerpoints, maar uitleg terwijl je de houdingen uitvoert. Je leert patronen in je lichaam direct herkennen en herprogrammeren door te voelen en te doen. Deze masterclasses geven bruikbare inzichten in anatomie, fascie en biomechanica.
            </li>
            <li>
              <strong class="text-gray-900">Zenuwstelsel &amp; Emotionele release:</strong> door gerichte, meditatieve beweging haal je je mind uit de controle-modus en breng je je hele systeem in een diepe staat van rust.
            </li>
            <li>
              <strong class="text-gray-900">Qi &amp; Energetische stroom:</strong> Qi Gong en Taoïstische principes laten je levensenergie vrij stromen, zodat je niet alleen ontspant, maar ook echt oplaadt.
            </li>
            <li>
              <strong class="text-gray-900">Veel persoonlijke aandacht:</strong> maximaal 16 deelnemers per middagsessie, uitgebreid ruimte voor individuele aanpassingen en specifieke vragen. (op = op)
            </li>
          </ul>
        </article>

        <!-- Het Drieluik -->
        <article class="rounded-lg border border-gray-200 bg-white p-7 space-y-4">
          <h2 class="text-2xl text-[#0f6dbf]">Het Drieluik</h2>
          <p class="text-sm text-gray-700 leading-relaxed">
            Elke middagsessie (14:00u – 17:30u) is los te volgen, maar ook als drieluik. De thema's versterken elkaar als een rode draad. We behandelen elk gebied altijd in relatie tot de totale biomechanica van het lichaam. Ideaal voor wie fundamentele kennis wil opbouwen en patronen wil doorbreken.
          </p>
          <ul class="space-y-2 text-sm text-gray-800 pt-3 border-t border-gray-200">
            {masterclasses.map((mc) => (
              <li><strong class="text-gray-900">Masterclass {mc.number} | {mc.dayLabel}:</strong> {mc.drieluikTheme}</li>
            ))}
          </ul>
        </article>

      </div>
    </section>

    <!-- Blok voor Inschrijven (#inschrijven, bg-blue-50 band) -->
    <section id="inschrijven" class="scroll-mt-20 bg-blue-50">
      <div class="mx-auto max-w-6xl px-6 py-12 space-y-8">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-2xl text-[#0f6dbf]">Inschrijven</h2>
            <span class="rounded bg-[#0f6dbf] px-2.5 py-0.5 text-xs font-semibold text-white">
              Middagsessies · 16 nieuwe plekken · op = op
            </span>
          </div>
          <p class="text-sm text-gray-700">
            De ochtendsessies zijn uitverkocht. Met onderstaande knoppen schrijf je je in voor de extra middagedities van 14:00u – 17:30u.
          </p>
        </div>

        <div class="space-y-6">
          <!-- Alle 3 de masterclasses (Drieluik) -->
          <div class="rounded-lg border-2 border-[#0f6dbf] bg-white p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded border border-gray-200 bg-gray-50 px-2 py-0.5 text-gray-500 line-through">Ochtend uitverkocht</span>
                <span class="rounded bg-blue-50 px-2 py-0.5 font-semibold text-[#0f6dbf]">Middag 14:00u – 17:30u · op = op</span>
              </div>
              <h3 class="text-xl text-[#0f6dbf]">Alle 3 de masterclasses (middag)</h3>
              <p class="text-sm text-gray-700">
                24 januari, 21 maart en 9 mei (14:00u – 17:30u) · <strong>€150</strong> (Voordelig drieluik tarief)
              </p>
            </div>

            <div class="shrink-0">
              <a 
                href={stripeLinks.allThree} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex w-full md:w-auto items-center justify-center rounded-lg bg-[#0f6dbf] hover:bg-[#0b5aa0] px-6 py-3 text-sm font-medium text-white transition"
              >
                Inschrijven alle 3 de middagsessies (€150)
              </a>
            </div>
          </div>

          <!-- Knoppen voor losse masterclasses -->
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {masterclasses.map((mc) => (
              <div class="rounded-lg border border-blue-100 bg-white p-5 space-y-3 flex flex-col justify-between">
                <div>
                  <span class="inline-block rounded bg-blue-50 px-2 py-0.5 text-xs font-semibold text-[#0f6dbf]">
                    Middag · 16 plekken
                  </span>
                  <h4 class="mt-2 font-semibold text-gray-900">Masterclass {mc.number}</h4>
                  <p class="text-xs text-gray-600">{mc.date} · 14:00u – 17:30u · €60</p>
                  <p class="text-xs text-gray-600 mt-1">{mc.shortTheme}</p>
                </div>
                <a 
                  href={mc.href} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="block w-full rounded-lg border-2 border-[#0f6dbf] bg-white hover:bg-[#0f6dbf] hover:text-white py-2 text-center text-xs font-semibold text-[#0f6dbf] transition"
                >
                  Inschrijven Masterclass {mc.number} – Middag (€60)
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Over Hannah Mutsaerts Section (wit) -->
    <section class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="md:col-span-4 flex justify-center">
          <div class="w-48 sm:w-56 md:w-full max-w-[260px] aspect-square overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
            <img 
              src="/opt/hannah-closeup.webp" 
              alt="Hannah Mutsaerts" 
              class="h-full w-full object-cover object-center" 
              loading="lazy" 
              decoding="async" 
            />
          </div>
        </div>

        <div class="md:col-span-8 space-y-4">
          <h2 class="text-2xl text-[#0f6dbf]">Over Hannah Mutsaerts</h2>
          <p class="leading-relaxed text-gray-700">
            Hannah heeft ruim 25 jaar praktijkervaring en 20 jaar ervaring als docent en therapeut. Door haar dubbele scholing in zowel de Westerse medische anatomie als Oosterse geneeskunde (Shiatsu en Taoïsme), heeft zij het vermogen om disbalansen direct op te sporen. Ze vertaalt fysieke signalen naar persoonlijke groei en biedt een nuchtere, veilige omgeving waarin kennis, respect en plezier centraal staan.
          </p>
          <p class="leading-relaxed text-gray-700">
            Stap van de mat met een kalm zenuwstelsel, anatomische inzichten en een lijf dat tintelt vol levensenergie.
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
