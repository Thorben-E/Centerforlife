---
import Layout from '../layouts/Layout.astro';
import Footer from '../layouts/Footer.astro';

const stripeLinks = {
  masterclass1: 'https://buy.stripe.com/aFa00j7Au1oI5ySeMzeZ208',
  masterclass2: 'https://buy.stripe.com/aFa9AT4oi6J2d1k5bZeZ20b',
  masterclass3: 'https://buy.stripe.com/cNi3cv4oi1oI8L4gUHeZ209',
  allThree: 'https://buy.stripe.com/3cI28r7Au0kE8L40VJeZ20c'
};
---

<Layout title="Masterclasses WORK – IN | Centerforlife">
  <main class="min-h-screen bg-slate-50/70 py-10 md:py-16 text-slate-800">
    <div class="mx-auto w-[92vw] max-w-5xl space-y-10 md:space-y-12">

      <!-- Hero Header Section -->
      <section class="rounded-3xl bg-white p-7 sm:p-10 md:p-12 shadow-sm border border-slate-100">
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10">
          
          <div class="lg:col-span-7 space-y-5">
            <div>
              <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-slate-900 leading-tight">
                Masterclasses
                <span class="block mt-1 font-normal text-[#0f6dbf] whitespace-nowrap" style="font-family: 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;">WORK – IN</span>
              </h1>
              <p class="mt-3 text-xl font-normal italic text-slate-700">
                Geen work-out, maar een work-in
              </p>
            </div>

            <div class="space-y-3 text-base leading-relaxed text-slate-700">
              <p>
                Stap 3,5 uur uit je dagelijkse routine. Geen haast, geen afleiding, kwaliteit voor jou.
              </p>
              <p class="font-medium text-slate-800">
                Ervaar praktisch hoe jij:
              </p>
              <ul class="list-disc list-inside space-y-1.5 pl-1 text-slate-700">
                <li>je zenuwstelsel kalmeert,</li>
                <li>je optimaal je lichaam beweegt,</li>
                <li>in je lijf zakt (in plaats van in je hoofd),</li>
                <li>jezelf mentaal een gezondheids boost geeft, en</li>
                <li>diep ontspant</li>
              </ul>
            </div>

            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a 
                href="#inschrijven" 
                class="inline-flex items-center justify-center rounded-xl bg-[#0f6dbf] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#0b5aa0]"
              >
                Meld me aan
              </a>
              <a 
                href="#inhoud" 
                class="inline-flex items-center justify-center rounded-xl border-2 border-[#0f6dbf] bg-white px-6 py-3 text-sm font-semibold text-[#0f6dbf] transition hover:bg-blue-50"
              >
                Lees de inhoud
              </a>
            </div>
          </div>

          <!-- Data, Tijden & Prijzen -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-blue-100 bg-[#f4f9ff] p-6 sm:p-7 space-y-5">
              <h2 class="text-base font-bold uppercase tracking-wider text-[#0f6dbf] border-b border-blue-100 pb-3">
                Data, Tijden &amp; Prijzen
              </h2>

              <div class="space-y-2 text-sm text-slate-800">
                <p><strong class="text-slate-900">24 januari:</strong> Masterclass 1 (Basis – Voeten, enkels en knieën)</p>
                <p><strong class="text-slate-900">21 maart:</strong> Masterclass 2 (Fundament – Bovenbenen, bekken, onderrug)</p>
                <p><strong class="text-slate-900">9 mei:</strong> Masterclass 3 (De As – Schouders, nek en armen)</p>
              </div>

              <div class="pt-2 border-t border-blue-100/80 space-y-1.5 text-sm text-slate-700">
                <p><strong class="text-slate-900">Tijd:</strong> van 9:30u tot 13:00u (inloop vanaf 09:15u)</p>
                <p><strong class="text-slate-900">Locatie:</strong> Home of Zen, Velperweg 95, Arnhem</p>
                <p class="text-xs text-[#0f6dbf] font-medium">Let op: niet in de studio in Velp!</p>
              </div>

              <!-- Prijzen -->
              <div class="pt-2 border-t border-blue-100/80 text-sm text-slate-800">
                <p>
                  <strong class="text-slate-900">Alle 3 de masterclasses:</strong> €150 <span class="text-slate-600">(bespaar €30 t.o.v. los)</span>
                </p>
              </div>

              <a 
                href="#inschrijven" 
                class="block w-full rounded-xl bg-[#0f6dbf] hover:bg-[#0b5aa0] py-3 text-center text-sm font-semibold text-white shadow-xs transition"
              >
                Direct inschrijven
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- 3 Masterclasses Platen & Titels -->
      <section class="grid grid-cols-1 gap-6 md:grid-cols-3">
        
        <!-- Masterclass 1 -->
        <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
          <div>
            <div class="aspect-[16/10] overflow-hidden bg-slate-100">
              <img 
                src="/masterclasses/masterclass-1-basis.jpg" 
                alt="Masterclass 1 Basis – Voeten, enkels en knieën – 24 januari" 
                class="h-full w-full object-cover" 
                loading="lazy" 
              />
            </div>
            <div class="p-6">
              <h3 class="text-base font-bold text-slate-900 leading-snug">
                Masterclass 1 Basis – Voeten, enkels en knieën – 24 januari
              </h3>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a 
              href={stripeLinks.masterclass1} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center rounded-xl bg-[#e8f2fc] hover:bg-[#0f6dbf] hover:text-white border border-[#0f6dbf] px-4 py-2.5 text-xs font-bold text-[#0f6dbf] transition"
            >
              Inschrijven Masterclass 1 (€60)
            </a>
          </div>
        </article>

        <!-- Masterclass 2 -->
        <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
          <div>
            <div class="aspect-[16/10] overflow-hidden bg-slate-100">
              <img 
                src="/masterclasses/masterclass-2-fundament.jpg" 
                alt="Masterclass 2: Fundament – bovenbenen, bekken, onderrug – 21 maart" 
                class="h-full w-full object-cover" 
                loading="lazy" 
              />
            </div>
            <div class="p-6">
              <h3 class="text-base font-bold text-slate-900 leading-snug">
                Masterclass 2: Fundament – bovenbenen, bekken, onderrug – 21 maart
              </h3>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a 
              href={stripeLinks.masterclass2} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center rounded-xl bg-[#e8f2fc] hover:bg-[#0f6dbf] hover:text-white border border-[#0f6dbf] px-4 py-2.5 text-xs font-bold text-[#0f6dbf] transition"
            >
              Inschrijven Masterclass 2 (€60)
            </a>
          </div>
        </article>

        <!-- Masterclass 3 -->
        <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
          <div>
            <div class="aspect-[16/10] overflow-hidden bg-slate-100">
              <img 
                src="/masterclasses/masterclass-3-as.jpg" 
                alt="Masterclass 3: De As – schouders, nek en armen – 9 mei" 
                class="h-full w-full object-cover" 
                loading="lazy" 
              />
            </div>
            <div class="p-6">
              <h3 class="text-base font-bold text-slate-900 leading-snug">
                Masterclass 3: De As – schouders, nek en armen – 9 mei
              </h3>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a 
              href={stripeLinks.masterclass3} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center rounded-xl bg-[#e8f2fc] hover:bg-[#0f6dbf] hover:text-white border border-[#0f6dbf] px-4 py-2.5 text-xs font-bold text-[#0f6dbf] transition"
            >
              Inschrijven Masterclass 3 (€60)
            </a>
          </div>
        </article>

      </section>

      <!-- Inhoud Section (#inhoud) -->
      <section id="inhoud" class="scroll-mt-20 grid grid-cols-1 gap-6 md:grid-cols-2">

        <!-- Wat houden de masterclasses in? -->
        <article class="rounded-2xl bg-white p-7 md:p-8 border border-slate-100 shadow-xs space-y-4">
          <h2 class="text-xl font-bold text-[#0f6dbf]">Wat houden de masterclasses in?</h2>
          <p class="text-slate-700 leading-relaxed text-sm">
            Dit is een actieve WORK-IN. We gaan doeltreffend bewegen, veiligheid ervaren en diep meditatief ontspannen. De uitleg krijg je tijdens het bewegen, zodat de kennis landt in je fascie, spieren en zenuwstelsel.
          </p>
          <div class="pt-1 space-y-2 text-sm text-slate-700">
            <p class="font-medium text-slate-900">We slaan een brug tussen:</p>
            <ul class="list-disc list-inside space-y-2 pl-1 leading-relaxed">
              <li>
                <strong class="text-slate-900">Westers bewegen door Fasciewerk en Biomechanica:</strong> ervaar hoe het fysieke lichaam anatomisch functioneert en hoe je compensaties in jouw manier van bewegen herprogrammeert.
              </li>
              <li>
                <strong class="text-slate-900">Oosters bewegen via Yoga en Qi Gong:</strong> laat je levensenergie stromen en toenemen door Yoga, Traditionele Chinese geneeskunde en Taoïsme.
              </li>
            </ul>
          </div>
        </article>

        <!-- Voor wie? -->
        <article class="rounded-2xl bg-white p-7 md:p-8 border border-slate-100 shadow-xs space-y-4">
          <h2 class="text-xl font-bold text-[#0f6dbf]">Voor wie?</h2>
          <ul class="list-disc list-inside space-y-2 text-sm text-slate-700 leading-relaxed pl-1">
            <li>Je komt al jaren bij mij op de mat en zoekt meer diepgang of verfijning.</li>
            <li>Je merkt dat je vastzit in je hoofd of in een gespannen lijf.</li>
            <li>Je wil meer ontdekken over de wonderlijke wereld van het fascie.</li>
            <li>Ervaren en meer beginnende deelnemers zijn welkom.</li>
          </ul>
          <p class="text-sm text-slate-700 pt-2 border-t border-slate-100">
            Ben je bij de vorige masterclasses geweest? Het uitgangspunt is nu hetzelfde maar we gebruiken veel andere oefeningen.
          </p>
        </article>

        <!-- Wat kun je verwachten? -->
        <article class="rounded-2xl bg-white p-7 md:p-8 border border-slate-100 shadow-xs space-y-4">
          <h2 class="text-xl font-bold text-[#0f6dbf]">Wat kun je verwachten?</h2>
          <ul class="list-disc list-inside space-y-2.5 text-sm text-slate-700 leading-relaxed pl-1">
            <li>
              <strong class="text-slate-900">Al doende leren:</strong> geen droge powerpoints, maar uitleg terwijl je de houdingen uitvoert. Je leert patronen in je lichaam direct herkennen en herprogrammeren door te voelen en te doen. Deze masterclasses geven bruikbare inzichten in anatomie, fascie en biomechanica.
            </li>
            <li>
              <strong class="text-slate-900">Zenuwstelsel &amp; Emotionele release:</strong> door gerichte, meditatieve beweging haal je je mind uit de controle-modus en breng je je hele systeem in een diepe staat van rust.
            </li>
            <li>
              <strong class="text-slate-900">Qi &amp; Energetische stroom:</strong> Qi Gong en Taoïstische principes laten je levensenergie vrij stromen, zodat je niet alleen ontspant, maar ook echt oplaadt.
            </li>
            <li>
              <strong class="text-slate-900">Veel persoonlijke aandacht:</strong> maximaal 16 deelnemers, uitgebreid ruimte voor individuele aanpassingen en specifieke vragen. (vol = vol)
            </li>
          </ul>
        </article>

        <!-- Het Drieluik -->
        <article class="rounded-2xl bg-white p-7 md:p-8 border border-slate-100 shadow-xs space-y-4">
          <h2 class="text-xl font-bold text-[#0f6dbf]">Het Drieluik</h2>
          <p class="text-sm text-slate-700 leading-relaxed">
            Elke ochtend is los te volgen, maar ook als drieluik. De thema's versterken elkaar als een rode draad. We behandelen elk gebied altijd in relatie tot de totale biomechanica van het lichaam. Ideaal voor wie fundamentele kennis wil opbouwen en patronen wil doorbreken.
          </p>
          <ul class="space-y-2 text-sm text-slate-800 pt-2 border-t border-slate-100">
            <li><strong class="text-slate-900">Masterclass 1 | Zondag 24 januari:</strong> de Basis – Voeten, enkels en knieën</li>
            <li><strong class="text-slate-900">Masterclass 2 | Zondag 21 maart:</strong> het Fundament – Bovenbenen, bekken en onderrug</li>
            <li><strong class="text-slate-900">Masterclass 3 | Zondag 9 mei:</strong> de As – Schouders, wervelkolom en bovenrug</li>
          </ul>
        </article>

      </section>

      <!-- Blok voor Inschrijven (#inschrijven) -->
      <section id="inschrijven" class="scroll-mt-20 rounded-3xl bg-white p-7 sm:p-10 md:p-12 border border-slate-200 shadow-sm space-y-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0f6dbf]">Inschrijven</h2>
        </div>

        <div class="space-y-6">

          <!-- Alle 3 de masterclasses (Drieluik) -->
          <div class="rounded-2xl border-2 border-blue-200 bg-[#f4f9ff] p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div class="space-y-1">
              <h3 class="text-xl font-bold text-slate-900">Alle 3 de masterclasses</h3>
              <p class="text-sm text-slate-700">
                24 januari, 21 maart en 9 mei · <strong>€150</strong> (Voordelig drieluik tarief)
              </p>
            </div>

            <div class="shrink-0">
              <a 
                href={stripeLinks.allThree} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex w-full md:w-auto items-center justify-center rounded-xl bg-[#0f6dbf] hover:bg-[#0b5aa0] px-7 py-3.5 text-sm font-bold text-white shadow-sm transition"
              >
                Inschrijven alle 3 de masterclasses (€150)
              </a>
            </div>
          </div>

          <!-- Knoppen voor losse masterclasses -->
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

            <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 flex flex-col justify-between">
              <div>
                <h4 class="font-bold text-slate-900">Masterclass 1</h4>
                <p class="text-xs text-slate-600">24 januari · €60</p>
                <p class="text-xs text-slate-500 mt-1">Basis – Voeten, enkels en knieën</p>
              </div>
              <a 
                href={stripeLinks.masterclass1} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block w-full rounded-lg bg-[#e8f2fc] hover:bg-[#0f6dbf] hover:text-white border border-[#0f6dbf] py-2.5 text-center text-xs font-bold text-[#0f6dbf] transition"
              >
                Inschrijven Masterclass 1 (€60)
              </a>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 flex flex-col justify-between">
              <div>
                <h4 class="font-bold text-slate-900">Masterclass 2</h4>
                <p class="text-xs text-slate-600">21 maart · €60</p>
                <p class="text-xs text-slate-500 mt-1">Fundament – bovenbenen, bekken, onderrug</p>
              </div>
              <a 
                href={stripeLinks.masterclass2} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block w-full rounded-lg bg-[#e8f2fc] hover:bg-[#0f6dbf] hover:text-white border border-[#0f6dbf] py-2.5 text-center text-xs font-bold text-[#0f6dbf] transition"
              >
                Inschrijven Masterclass 2 (€60)
              </a>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 flex flex-col justify-between">
              <div>
                <h4 class="font-bold text-slate-900">Masterclass 3</h4>
                <p class="text-xs text-slate-600">9 mei · €60</p>
                <p class="text-xs text-slate-500 mt-1">De As – schouders, nek en armen</p>
              </div>
              <a 
                href={stripeLinks.masterclass3} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block w-full rounded-lg bg-[#e8f2fc] hover:bg-[#0f6dbf] hover:text-white border border-[#0f6dbf] py-2.5 text-center text-xs font-bold text-[#0f6dbf] transition"
              >
                Inschrijven Masterclass 3 (€60)
              </a>
            </div>

          </div>

        </div>
      </section>

      <!-- Over Hannah Mutsaerts Section -->
      <section class="rounded-3xl bg-white p-7 sm:p-10 md:p-12 border border-slate-100 shadow-xs">
        <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-12 md:gap-10">
          
          <div class="md:col-span-4 flex justify-center">
            <div class="w-48 sm:w-56 md:w-full max-w-[260px] aspect-square overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img 
                src="/opt/hannah-closeup.webp" 
                alt="Hannah Mutsaerts" 
                class="h-full w-full object-cover object-center" 
                loading="lazy" 
                decoding="async" 
              />
            </div>
          </div>

          <div class="md:col-span-8 space-y-4">
            <h2 class="text-2xl font-bold text-[#0f6dbf]">Over Hannah Mutsaerts</h2>
            <p class="text-sm leading-relaxed text-slate-700">
              Hannah heeft ruim 25 jaar praktijkervaring en 20 jaar ervaring als docent en therapeut. Door haar dubbele scholing in zowel de Westerse medische anatomie als Oosterse geneeskunde (Shiatsu en Taoïsme), heeft zij het vermogen om disbalansen direct op te sporen. Ze vertaalt fysieke signalen naar persoonlijke groei en biedt een nuchtere, veilige omgeving waarin kennis, respect en plezier centraal staan.
            </p>
            <p class="text-sm leading-relaxed text-slate-700">
              Stap van de mat met een kalm zenuwstelsel, anatomische inzichten en een lijf dat tintelt vol levensenergie.
            </p>
          </div>

        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
