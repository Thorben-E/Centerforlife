---
import Layout from '../layouts/Layout.astro';
import Footer from '../layouts/Footer.astro';
---

<Layout title=''>
	<main>
		<div class="flex min-h-[calc(100svh-12vh)] flex-col">
		<section class="grid min-h-0 w-full flex-1 grid-rows-2 gap-1 sm:grid-cols-2 sm:grid-rows-1">
			<a href="/workin" class="relative block h-full min-h-0 overflow-hidden">
				<img src="/opt/studio_velp_website.webp" alt="Studio in Velp" class="absolute inset-0 h-full w-full object-cover brightness-[0.75]" fetchpriority="high" decoding="async">
				<span class="relative z-10 flex h-full w-full items-center justify-center px-6 text-center text-white">
					<span>
						<span class="block text-3xl sm:text-4xl">Ga naar Work-In</span>
						<span class="mt-2 block text-lg font-normal">Online lessen</span>
					</span>
				</span>
			</a>
			<a href="/shiatsu" class="relative block h-full min-h-0 overflow-hidden">
				<img src="/opt/shiatsu2.webp" alt="Shiatsu behandeling" class="absolute inset-0 h-full w-full object-cover brightness-[0.75]" fetchpriority="high" decoding="async">
				<span class="relative z-10 flex h-full w-full items-center justify-center px-6 text-center text-white">
					<span>
						<span class="block text-3xl sm:text-4xl">Ga naar Shiatsu</span>
						<span class="mt-2 block text-lg font-normal">Behandeling</span>
					</span>
				</span>
			</a>
		</section>
		<div id="cookieWrapper" class="hidden">
			<div class="flex items-center justify-center gap-4 border-t bg-[#f7f7f7] px-4 py-3 text-center">
				<p class="text-sm text-gray-700">Deze website gebruikt cookies om de site goed te laten werken.</p>
				<button class="rounded border border-[#0f6dbf] px-3 py-1 text-[#0f6dbf]" id="cookieBtn" type="button">Akkoord</button>
			</div>
		</div>
		<a href="#nieuwsbrief" class="bg-[#0f6dbf] py-3 text-center text-white">Inschrijven nieuwsbrief</a>
		</div>

		<aside id="masterclassPopup" aria-label="Extra middagsessies Masterclasses" class="fixed bottom-14 right-4 z-40 w-[calc(100vw-2rem)] max-w-sm rounded-lg border-2 border-[#0f6dbf] bg-white p-5 shadow-xl sm:bottom-16 sm:right-6">
			<div class="flex items-start justify-between gap-3">
				<p class="text-xs font-semibold uppercase tracking-wider text-[#0f6dbf]">
					Masterclasses WORK – IN
				</p>
				<button id="closeMasterclassPopup" type="button" aria-label="Sluit melding" class="-mr-1 -mt-1 rounded p-1 text-gray-400 transition hover:bg-blue-50 hover:text-[#0f6dbf]">
					<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
					</svg>
				</button>
			</div>
			<h2 class="mt-1 text-lg font-semibold text-[#0f6dbf]">
				Extra middagsessies geopend
			</h2>
			<p class="mt-1.5 text-sm leading-relaxed text-gray-700">
				Wegens groot succes zijn de ochtenden uitverkocht. De masterclass wordt nu ook in de middag (14:00u – 17:30u) gegeven: <strong class="font-semibold text-gray-900">16 nieuwe plekken</strong>, op = op.
			</p>
			<a href="/events" class="mt-4 block w-full rounded-lg bg-[#0f6dbf] px-4 py-2.5 text-center text-sm font-medium text-white transition hover:bg-[#0b5aa0]">
				Bekijk &amp; meld je aan
			</a>
		</aside>

		<Footer />
	</main>
</Layout>

<script>
	const cookieBox = document.getElementById('cookieWrapper');
	const acceptBtn = document.getElementById('cookieBtn');

	acceptBtn.onclick = () => {
		document.cookie = "CookieBy=Centerforlife; max-age=" + 60 * 60 * 24 * 30;
		if (document.cookie) {
			cookieBox.classList.add('hidden');
		} else {
			alert("Cookie kan niet geplaatst worden.");
		}
	};

	if (!document.cookie) {
		cookieBox.classList.remove('hidden');
	}

	const masterclassPopup = document.getElementById('masterclassPopup');
	const closeMasterclassPopup = document.getElementById('closeMasterclassPopup');
	if (masterclassPopup && closeMasterclassPopup) {
		closeMasterclassPopup.addEventListener('click', () => {
			masterclassPopup.classList.add('hidden');
		});
	}
</script>
