---
import Layout from '../layouts/Layout.astro';
import Footer from '../layouts/Footer.astro';
---

<Layout title=''>
	<main>
		<div class="flex min-h-[calc(100svh-12vh)] flex-col">
		<section class="grid min-h-0 w-full flex-1 grid-rows-2 gap-1 sm:grid-cols-2 sm:grid-rows-1">
			<a href="/workin" class="relative block h-full min-h-0 overflow-hidden">
				<img src="/opt/studio_velp_website.webp" alt="Studio in Velp" class="absolute inset-0 h-full w-full object-cover brightness-[0.75]" fetchpriority="high" decoding="async">
				<span class="relative z-10 flex h-full w-full items-center justify-center px-6 text-center text-white">
					<span>
						<span class="block text-3xl sm:text-4xl">Ga naar Work-In</span>
						<span class="mt-2 block text-lg font-normal">Online lessen</span>
					</span>
				</span>
			</a>
			<a href="/shiatsu" class="relative block h-full min-h-0 overflow-hidden">
				<img src="/opt/shiatsu2.webp" alt="Shiatsu behandeling" class="absolute inset-0 h-full w-full object-cover brightness-[0.75]" fetchpriority="high" decoding="async">
				<span class="relative z-10 flex h-full w-full items-center justify-center px-6 text-center text-white">
					<span>
						<span class="block text-3xl sm:text-4xl">Ga naar Shiatsu</span>
						<span class="mt-2 block text-lg font-normal">Behandeling</span>
					</span>
				</span>
			</a>
		</section>
		<div id="cookieWrapper" class="hidden">
			<div class="flex items-center justify-center gap-4 border-t bg-[#f7f7f7] px-4 py-3 text-center">
				<p class="text-sm text-gray-700">Deze website gebruikt cookies om de site goed te laten werken.</p>
				<button class="rounded border border-[#0f6dbf] px-3 py-1 text-[#0f6dbf]" id="cookieBtn" type="button">Akkoord</button>
			</div>
		</div>
		<a href="#nieuwsbrief" class="bg-[#0f6dbf] py-3 text-center text-white">Inschrijven nieuwsbrief</a>
		</div>
		<Footer />
	</main>
</Layout>

<script>
	const cookieBox = document.getElementById('cookieWrapper');
	const acceptBtn = document.getElementById('cookieBtn');

	acceptBtn.onclick = () => {
		document.cookie = "CookieBy=Centerforlife; max-age=" + 60 * 60 * 24 * 30;
		if (document.cookie) {
			cookieBox.classList.add('hidden');
		} else {
			alert("Cookie kan niet geplaatst worden.");
		}
	};

	if (!document.cookie) {
		cookieBox.classList.remove('hidden');
	}
</script>
